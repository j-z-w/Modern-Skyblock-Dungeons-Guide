{
  "schemaVersion": 1,
  "id": "dungeonsguide",
  "version": "${version}",
  "name": "Modern Dungeons Guide",
  "description": "A Minecraft 26.3 Fabric port of Dungeons Guide focused on Hypixel Skyblock dungeon secret routing and pathfinding.",
  "authors": [
    "cyoung06 (syeyoung)",
    "Modern Dungeons Guide contributors"
  ],
  "contact": {
    "homepage": "https://github.com/j-z-w/Modern-Skyblock-Dungeons-Guide",
    "sources": "https://github.com/j-z-w/Modern-Skyblock-Dungeons-Guide",
    "issues": "https://github.com/j-z-w/Modern-Skyblock-Dungeons-Guide/issues"
  },
  "license": "AGPL-3.0-or-later",
  "icon": "assets/dungeonsguide/textures/dglogox128round.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "kr.syeyoung.dungeonsguide.launcher.FabricEntrypoint"
    ]
  },
  "mixins": [
    "dungeonsguide.mixins.json"
  ],
  "accessWidener": "dungeonsguide.classtweaker",
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
